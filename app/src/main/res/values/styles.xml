<?xml version="1.0" encoding="utf-8"?>

<resources>
    <style name="ShapeAppearance.SubTracker.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/field_corner</item>
    </style>
    <style name="ShapeAppearance.SubTracker.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/button_corner</item>
    </style>
    <style name="ShapeAppearance.SubTracker.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_corner</item>
    </style>
    <style name="ShapeAppearance.SubTracker.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/chip_corner</item>
    </style>
    <style name="Widget.SubTracker.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Field</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/st_surface</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/st_error</item>
        <item name="boxStrokeErrorColor">@color/st_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="startIconTint">@color/st_text_secondary</item>
        <item name="endIconTint">@color/st_text_secondary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.SubTracker.TextField</item>
    </style>
    <style name="ThemeOverlay.SubTracker.TextField" parent="">
        <item name="editTextStyle">@style/Widget.SubTracker.EditText</item>
    </style>
    <style name="Widget.SubTracker.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/st_text_primary</item>
        <item name="android:textColorHint">@color/st_text_secondary</item>
    </style>
    <style name="Widget.SubTracker.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Field</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/st_surface</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/st_text_secondary</item>
    </style>
    <style name="Widget.SubTracker.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/chip_background</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Field</item>
    </style>
    <style name="Widget.SubTracker.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/st_text_secondary</item>
    </style>
    <style name="Widget.SubTracker.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.SubTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/st_text_primary</item>
        <item name="strokeColor">@color/st_border</item>
        <item name="backgroundTint">@color/st_surface</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="Widget.SubTracker.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.SubTracker.IconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="tint">@color/st_text_primary</item>
        <item name="android:scaleType">centerInside</item>
    </style>
    <style name="Widget.SubTracker.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Card</item>
        <item name="cardBackgroundColor">@color/st_surface</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.SubTracker.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.SubTracker.Chip</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.SubTracker.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/st_text_primary</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="TextAppearance.SubTracker.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/st_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.SubTracker.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/st_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="TextAppearance.SubTracker.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/st_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.SubTracker.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/st_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
