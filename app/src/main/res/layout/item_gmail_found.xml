<?xml version="1.0" encoding="utf-8"?>
<!-- Un abonament găsit în Gmail: bifă, avatar, nume, detalii și suma estimată. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <!-- Bifa nu primește atingeri: se schimbă la apăsarea pe tot rândul -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/selectedCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/avatarText"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_rounded_square"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:backgroundTint="@color/cat_streaming"
            tools:text="N" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/st_text_primary"
                android:textSize="16sp"
                tools:text="Netflix" />

            <TextView
                android:id="@+id/metaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/st_text_secondary"
                android:textSize="13sp"
                tools:text="Streaming · ultimul email 3 nov." />
        </LinearLayout>

        <TextView
            android:id="@+id/priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/st_text_primary"
            android:textSize="16sp"
            tools:text="49,99 lei" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
