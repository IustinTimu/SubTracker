<?xml version="1.0" encoding="utf-8"?>
<!--
    Import din Gmail. Ecranul are patru panouri, dintre care unul singur este vizibil:
    introducere → încărcare → lista „Abonamente găsite” sau un mesaj (nimic găsit / eroare).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_background"
    android:orientation="vertical"
    tools:context=".ui.gmail.GmailImportActivity">

    <include layout="@layout/view_screen_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Introducere: ce face importul și ce se întâmplă cu datele -->
        <LinearLayout
            android:id="@+id/introPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_inbox"
                    app:tint="@color/st_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/gmail_intro_title"
                android:textAppearance="@style/TextAppearance.SubTracker.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/gmail_intro_text"
                android:textAppearance="@style/TextAppearance.SubTracker.Body" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/st_primary_container"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/st_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/gmail_privacy"
                        android:textColor="@color/st_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/Widget.SubTracker.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/gmail_connect"
                app:icon="@drawable/ic_mail"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- 2. Încărcare -->
        <LinearLayout
            android:id="@+id/loadingPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/st_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/gmail_searching"
                android:textAppearance="@style/TextAppearance.SubTracker.Body" />
        </LinearLayout>

        <!-- 3. Abonamente găsite -->
        <LinearLayout
            android:id="@+id/resultsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/gmail_found_title"
                android:textAppearance="@style/TextAppearance.SubTracker.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginTop="4dp"
                android:text="@string/gmail_found_subtitle"
                android:textAppearance="@style/TextAppearance.SubTracker.Body" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/foundList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingVertical="8dp"
                tools:listitem="@layout/item_gmail_found" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/importButton"
                style="@style/Widget.SubTracker.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/screen_padding"
                tools:text="Importă selecția (3)" />
        </LinearLayout>

        <!-- 4. Mesaj: nimic găsit sau eroare -->
        <LinearLayout
            android:id="@+id/messagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_logo">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_inbox"
                    app:tint="@color/st_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SubTracker.Body"
                tools:text="@string/gmail_none_found" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.SubTracker.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:text="@string/gmail_try_again" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
